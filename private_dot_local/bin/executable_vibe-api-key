#!/usr/bin/env bash
set -euo pipefail

VIBE_PY=/home/mat/.local/share/uv/tools/mistral-vibe/bin/python

if [[ ! -x "$VIBE_PY" ]]; then
  echo "vibe-api-key: Python de mistral-vibe introuvable ($VIBE_PY) — réinstalle mistral-vibe (uv tool install mistral-vibe)" >&2
  exit 1
fi

key=$("$VIBE_PY" -c "import keyring; print(keyring.get_password('ai.mistral.vibe', 'MISTRAL_API_KEY'))" 2>/dev/null || true)

if [[ -z "${key:-}" && -f "$HOME/.vibe/.env" ]]; then
  key=$(grep -E '^MISTRAL_API_KEY=' "$HOME/.vibe/.env" | head -1 | cut -d= -f2-)
fi

if [[ -z "${key:-}" ]]; then
  echo "vibe-api-key: clé vibe absente (keyring ai.mistral.vibe et ~/.vibe/.env vides) — lance 'vibe' et signe-toi" >&2
  exit 1
fi

printf '%s' "$key"
