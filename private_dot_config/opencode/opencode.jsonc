{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "us-east-1",
        "profile": "genai-prod"
      }
    }
  },
  "model": "amazon-bedrock/openai.gpt-5.6-luna",
  "default_agent": "plan",
  "instructions": ["~/.pi/agent/AGENTS.md"],
  "permission": "allow"
}
